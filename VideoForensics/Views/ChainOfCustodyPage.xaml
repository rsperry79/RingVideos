<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="VideoForensics.Views.ChainOfCustodyPage" Title="Chain of Custody">
    <VerticalStackLayout Padding="15">
        <Label Text="Evidence Audit Trail" FontSize="20" FontAttributes="Bold" />
        <Frame BorderColor="#E0E0E0" CornerRadius="8" Padding="12"><Label Text="{Binding IntegrityVerified, StringFormat='Integrity: {0}'}" FontSize="14" TextColor="#2E7D32" /></Frame>
        <CollectionView ItemsSource="{Binding CustodyEntries}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,5" CornerRadius="8" BorderColor="#E0E0E0" Padding="12">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="{Binding Handler}" FontAttributes="Bold" />
                            <Label Text="{Binding Action}" FontSize="11" TextColor="#666" />
                            <Label Text="{Binding Timestamp, StringFormat='{0:g}'}" FontSize="10" TextColor="#999" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>
