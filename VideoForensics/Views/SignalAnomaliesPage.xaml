<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="VideoForensics.Views.SignalAnomaliesPage" Title="Signal Anomalies">
    <VerticalStackLayout Padding="15">
        <Label Text="RF Signal Analysis" FontSize="20" FontAttributes="Bold" />
        <Frame BorderColor="#E0E0E0" CornerRadius="8" Padding="12"><Label Text="{Binding AnomalyPercentage, StringFormat='Anomalies Detected: {0:F1}%'}" FontSize="14" /></Frame>
        <CollectionView ItemsSource="{Binding Anomalies}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,5" CornerRadius="8" BorderColor="#ff8c00" Padding="12">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="{Binding AnomalyType}" FontAttributes="Bold" TextColor="#ff8c00" />
                            <Label Text="{Binding Description}" FontSize="11" TextColor="#999" />
                            <Label Text="{Binding DeviationFromMedian, StringFormat='Deviation: {0:F1}%'}" FontSize="10" TextColor="#666" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>
