<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VideoForensics.Views.ForensicReportsPage"
             Title="Forensic Reports">
    <VerticalStackLayout Padding="15">
        <Label Text="Analysis Reports" FontSize="20" FontAttributes="Bold" />
        <CollectionView ItemsSource="{Binding Reports}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,5" CornerRadius="8" BorderColor="#E0E0E0" Padding="12">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="{Binding ReportId}" FontAttributes="Bold" />
                            <Label Text="{Binding AnalysisType}" FontSize="12" TextColor="#666" />
                            <Label Text="{Binding Summary}" FontSize="11" TextColor="#999" />
                            <Button Text="Export" FontSize="11" WidthRequest="80" Padding="3" BackgroundColor="#2E7D32" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>
