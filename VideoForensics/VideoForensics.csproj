    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <AssemblyName>VideoForensics</AssemblyName>
        <RootNamespace>VideoForensics</RootNamespace>
        <Version>1.0.0</Version>
        <Authors>DV Victim Protection Team</Authors>
        <Description>Desktop forensic evidence analysis application for DV victim protection</Description>
        <Copyright>2026</Copyright>
        <PackageLicenseExpression>EPL-2.0</PackageLicenseExpression>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Spectre.Console" Version="0.57.2" />
        <PackageReference Include="System.CommandLine" Version="2.0.11" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\external\RingApi\src\api\Ring.Api.csproj" />
