<?xml version = "1.0" encoding = "UTF-8" ?>
<Application
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="VideoForensics.App">

    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="PageBackgroundColor">#FFFFFF</Color>
            <Color x:Key="Primary">#2E7D32</Color>
            <Color x:Key="Secondary">#C8E6C9</Color>
            <Color x:Key="Tertiary">#1B5E20</Color>
            <Color x:Key="Success">#00AA00</Color>
            <Color x:Key="Warning">#FF8C00</Color>
            <Color x:Key="Danger">#FF0000</Color>
            <Color x:Key="Critical">#D32F2F</Color>
            <Color x:Key="InfoBackground">#E8F4F8</Color>
            <Color x:Key="Gray200">#E0E0E0</Color>
            <Color x:Key="Gray300">#D3D3D3</Color>
            <Color x:Key="Gray400">#C8C8C8</Color>
            <Color x:Key="Gray500">#808080</Color>

            <Style x:Key="LargeLabelStyle" TargetType="Label">
                <Setter Property="FontSize" Value="32"/>
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}"/>
            </Style>

            <Style x:Key="MediumLabelStyle" TargetType="Label">
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource White}}"/>
            </Style>

            <Style x:Key="SmallLabelStyle" TargetType="Label">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray200}}"/>
            </Style>

            <Style x:Key="SuccessButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Success}"/>
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="BorderRadius" Value="5"/>
            </Style>

            <Style x:Key="WarningButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Warning}"/>
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="BorderRadius" Value="5"/>
            </Style>

            <Style x:Key="DangerButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Danger}"/>
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="BorderRadius" Value="5"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
