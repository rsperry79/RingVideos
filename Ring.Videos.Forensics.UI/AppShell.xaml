<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Ring.Videos.Forensics.UI.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <TabBar>
        <ShellContent Title="Evidence" ContentTemplate="{DataTemplate local:MainPage}" Route="MainPage" />
        <ShellContent Title="Reports" ContentTemplate="{DataTemplate local:ForensicReportsPage}" Route="ForensicReportsPage" />
        <ShellContent Title="Signal Analysis" ContentTemplate="{DataTemplate local:SignalAnomaliesPage}" Route="SignalAnomaliesPage" />
        <ShellContent Title="Chain of Custody" ContentTemplate="{DataTemplate local:ChainOfCustodyPage}" Route="ChainOfCustodyPage" />
        <ShellContent Title="Access Control" ContentTemplate="{DataTemplate local:AccessControlPage}" Route="AccessControlPage" />
    </TabBar>

    <Shell.BackgroundColor>
        <OnPlatform x:TypeArguments="Color">
            <On Platform="WinUI" Value="#FFFFFF"/>
            <On Platform="MacCatalyst" Value="#FFFFFF"/>
            <On Platform="Android" Value="#FFFFFF"/>
        </OnPlatform>
    </Shell.BackgroundColor>
</Shell>
